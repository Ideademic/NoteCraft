<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.2.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>NoteCraft</string>
  <key>CFBundleName</key>
  <string>NoteCraft</string>
  <key>CFBundleExecutable</key>
  <string>NoteCraft</string>
  <key>CFBundleIdentifier</key>
  <string>com.ideademic.notecraft</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>NoteCraftVersion</key>
  <string>@VERSION@</string>
  <key>NoteCraftBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>NoteCraft</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.productivity</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © the NoteCraft authors. MIT OR Apache-2.0.</string>

  <!-- Documents NoteCraft opens. Alternate rank: NoteCraft is offered in "Open With" but never
       takes the default handler from another app. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>OneNote Section</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.microsoft.onenote.section</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>OneNote Table of Contents</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.microsoft.onenote.toc</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>OneNote Package</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.microsoft.onenote.package</string>
      </array>
    </dict>
  </array>
  <!-- NoteCraft doesn't own these formats, so it imports (not exports) their type declarations;
       the system or another installed app's declaration wins where one exists. -->
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.microsoft.onenote.section</string>
      <key>UTTypeDescription</key>
      <string>OneNote Section</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.content</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>one</string>
        </array>
        <key>public.mime-type</key>
        <array>
          <string>application/onenote</string>
        </array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.microsoft.onenote.toc</string>
      <key>UTTypeDescription</key>
      <string>OneNote Table of Contents</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>onetoc2</string>
        </array>
        <key>public.mime-type</key>
        <array>
          <string>application/onenote</string>
        </array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.microsoft.onenote.package</string>
      <key>UTTypeDescription</key>
      <string>OneNote Package</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.archive</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>onepkg</string>
        </array>
        <key>public.mime-type</key>
        <array>
          <string>application/onenote</string>
        </array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
